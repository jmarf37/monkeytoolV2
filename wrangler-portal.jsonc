{
  "name": "monkeytools-portal",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "worker/portal-entry.ts",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "monkeytools-auth",
      "database_id": "948fdf71-9b8b-4abc-a4e7-90ce9caa5104"
    }
  ],
  "services": [
    {
      "binding": "IP_SERVICE",
      "service": "monkeytoolv2"
    },
    {
      "binding": "DOMAIN_SERVICE",
      "service": "monkeytoolv2-domain"
    },
    {
      "binding": "HASH_SERVICE",
      "service": "monkeytoolv2-hash"
    }
  ],
  "keep_vars": true
}
